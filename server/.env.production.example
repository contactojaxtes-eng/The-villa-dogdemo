NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://NEW_USER:NEW_PASSWORD@NEW_PRIVATE_HOST:5432/NEW_DATABASE
JWT_SECRET=CHANGE_ME_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CLIENT_URL=https://NEW_DOMAIN.example
# Public customer-facing menu domain, for example https://menu.NEW_DOMAIN.example/menu
PUBLIC_MENU_URL=https://menu.NEW_DOMAIN.example/menu
ALLOWED_ORIGINS=https://NEW_DOMAIN.example
DATA_DIR=/app/data
# Receipt image bytes expire after this many days, during a later cash closing.
# Amounts, review decisions and sales history are retained. Set 0 to disable expiry.
RECEIPT_RETENTION_DAYS=30
# Keep activation closed during deployment. Enable it only for reviewed site codes,
# separated by commas (for example: villa-luz,norte).
MULTISITE_ACTIVATION_ENABLED=false
MULTISITE_ACTIVATION_SITE_CODES=
# Optional; required only for the newly configured print bridge (x-print-token header).
PRINT_BRIDGE_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Correos ADMIN autorizados para administrar todas las sedes. Es obligatorio
# definirlo antes del primer arranque multisede cuando hay más de un ADMIN.
ORGANIZATION_ADMIN_EMAILS=
