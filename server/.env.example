DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
JWT_SECRET="CHANGE_ME_GENERATE_A_NEW_LONG_RANDOM_SECRET"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
PORT="3000"
CLIENT_URL="http://localhost:5173"
# Public customer-facing menu domain. Keep it separate from the admin/API domain in production.
PUBLIC_MENU_URL="http://localhost:5173/menu"
ALLOWED_ORIGINS="http://localhost:5173"
NODE_ENV="development"

# Safety gate for activating prepared secondary sites. Both values are required.
MULTISITE_ACTIVATION_ENABLED="false"
MULTISITE_ACTIVATION_SITE_CODES=""

WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_VERIFY_TOKEN="CHANGE_ME_THE_VILLA_DOG_VERIFY_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID=""

GEMINI_API_KEY=""

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Si existe más de un ADMIN antes de habilitar multisede, indica aquí (separados
# por coma) cuáles conservarán alcance para administrar todas las sedes.
ORGANIZATION_ADMIN_EMAILS=
